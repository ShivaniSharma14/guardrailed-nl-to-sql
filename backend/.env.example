# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me          # generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=True

# PostgreSQL
POSTGRES_DB=nl_to_sql
POSTGRES_USER=nl_to_sql
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres               # matches the 'postgres' service name in compose.yaml
POSTGRES_PORT=5432

# LLM provider (Groq, OpenAI-compatible API)
AI_PROVIDER_API_KEY=change-me        # required — service raises an error at startup without this
AI_PROVIDER_BASE_URL=https://api.groq.com/openai/v1   # optional, this is the default
AI_MODEL_NAME=openai/gpt-oss-120b                       # optional, this is the default